# Binaries and archives
/bin/
/downloads/
/data/
/logs/
/tmp/
*.zip
*.phar
*.exe
*.dll

# Virtual hosts (local user projects)
/conf/vhosts/*.conf
!/conf/vhosts/.gitkeep

# Python
__pycache__/
*.pyc
scratch/

# OS
Thumbs.db
Desktop.ini

# Estado generado por instalación (se crea al primer arranque)
/conf/state.json
/conf/nginx.conf
/conf/my.ini
/projects/

# Accesos directos (contienen rutas y SID del equipo)
*.lnk

# Paquetes de release generados
/dist/
/.update-backup/

# Copia del archivo hosts de Windows antes de que AetherStack lo modifique
/conf/hosts.backup
